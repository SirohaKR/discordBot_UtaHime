DISCORD_TOKEN=your-bot-token-here
FFMPEG_PATH=

# 웹 설정 페이지 (web/app.py)
WEB_ADMIN_TOKEN=change-me-to-a-random-secret
FLASK_SECRET_KEY=change-me-too
WEB_PORT=5000

# WEB_PUBLIC_URL: 웹 관리 페이지를 실제로 여는 외부 주소 (포트 포함, 맨 끝에 / 없이)
# 예: WEB_PUBLIC_URL=http://exdrone.synology.me:5050
WEB_PUBLIC_URL=

# "내 목소리 설정"(/my-voice) 페이지의 디스코드 로그인(OAuth2)
#   1. https://discord.com/developers/applications → 봇 앱 → OAuth2
#   2. Redirects에 "{WEB_PUBLIC_URL}/oauth/callback" 추가
#   3. Client ID / Client Secret을 아래에 붙여넣기
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# 에러 알림 (선택) - 재생 실패, 처리되지 않은 예외 등을 디스코드로 알림
# 채널 ID를 설정하면 해당 채널로, 없으면 OWNER_ID로 DM 시도. 둘 다 비우면 콘솔에만 남음.
ERROR_LOG_CHANNEL_ID=
OWNER_ID=

# Claude: 프롬프트 추천 채널, 자유 채팅 (Claude Sonnet 5)
# console.anthropic.com 가입 → 결제수단 등록 → API Keys에서 발급 → 아래에 붙여넣기
ANTHROPIC_API_KEY=

# MY_GUILD_ID: 이 서버에는 슬래시 명령어가 디스코드 캐시 지연(최대 1시간) 없이 바로 뜸
MY_GUILD_ID=

# TTS - AWS Polly (선택, 유료 — 비워두면 무료 edge-tts만 동작)
# IAM에서 "AmazonPollyReadOnlyAccess" 권한만 있는 사용자를 만들어 발급받은 값.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2

# TTS - 타입캐스트 (선택, 유료) https://typecast.ai/docs/ko/quickstart
TYPECAST_API_KEY=
